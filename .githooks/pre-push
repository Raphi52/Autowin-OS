#!/bin/sh
# Deux garde-fous :
#   1. Anti-fuite (pour tous) : refuse tout push vers GitHub dont un commit contient `entreprise/`
#      — section « DÉPÔT PUBLIC » plus bas, prouvée par src/main/githooks-pre-push.test.ts.
#   2. Anti-collision : interdit le push direct sur la branche par défaut — AUX AGENTS.
#
# Contexte d'origine : plusieurs devs/agents travaillant sur `main` dans le même checkout ont produit
# des changements entremêlés, des fichiers supprimés sous les pieds d'une autre session et un HEAD
# incohérent. Règle de l'équipe (ONBOARDING.md §7) : 1 branche par sujet + Pull Request.
#
# CORRIGÉ le 2026-07-29 — l'intention et l'implémentation divergeaient. La règle visait les AGENTS
# autonomes d'Autowin OS, mais le hook bloquait TOUT push sur `main`, humain compris. Conséquence
# observée : un humain qui consolide ses branches devait enjamber sa propre garde à chaque fois avec
# `ALLOW_MAIN_PUSH=1`. Une garde qu'on contourne systématiquement ne protège rien et brouille le signal
# (cicatrice mesurée : 60 commits poussés droit sur main en un jour, hook échappé chaque fois).
#
# Le hook reste DÉTERMINISTE et hors-modèle : il refuse, il ne conseille pas.
# Activation (une fois par machine) : git config core.hooksPath .githooks
# Échappatoire explicite et tracée : ALLOW_MAIN_PUSH=1 git push
PROTECTED="main master"

# Branche par défaut du remote si connue (sinon on garde la liste ci-dessus).
remote_head=$(git symbolic-ref --quiet --short "refs/remotes/$1/HEAD" 2>/dev/null | sed "s|^$1/||")
[ -n "$remote_head" ] && PROTECTED="$PROTECTED $remote_head"

# ─── QUI POUSSE ? ────────────────────────────────────────────────────────────────────────────────
# Deux signaux POSITIFS d'un contexte agent, tous deux posés par Autowin OS lui-même :
#   1. `AUTOWIN_OS_WORKSPACE` — la variable que l'app injecte dans l'environnement de chaque CLI
#      qu'elle lance (cf. `src/shared/app-identity.ts`). Un humain dans son terminal ne l'a pas.
#   2. Le chemin de l'arbre de travail : les agents opèrent dans des worktrees nommés `agent__<id>` ou
#      `integration__<id>__<uuid>` (cf. `src/main/store/worktree-manager.ts`). Un humain travaille
#      dans le checkout principal.
# On bloque sur détection POSITIVE. En cas de doute (aucun signal), on laisse passer : la garde vise
# l'automate, et un faux blocage de l'humain était précisément le défaut corrigé.
is_agent=0
[ -n "$AUTOWIN_OS_WORKSPACE" ] && is_agent=1
worktree=$(git rev-parse --show-toplevel 2>/dev/null)
case "$worktree" in
  */agent__* | */integration__* | */.quarantine/*) is_agent=1 ;;
esac

# ─── DÉPÔT PUBLIC : JAMAIS LE DOSSIER DE L'ENTREPRISE ───────────────────────────────────────────
# Ajouté le 2026-10-13 (conv-932). Ce qui est propre à l'entreprise vit dans `entreprise/` et ne
# part JAMAIS sur GitHub. Depuis le 2026-10-16 (conv-994), GitHub est le SEUL distant (`origin`) et
# `entreprise/` est ignoré par git (`.gitignore`) : il reste sur le disque. Un commit qui le contient
# vient donc de l'historique d'avant la bascule (avant 9f95ebe8) ou d'un ajout forcé. Ce refus vaut
# pour TOUT pousseur, humain compris, et n'a pas d'exception.
#
# QUEL DISTANT EST PUBLIC : son adresse pointe vers github.com. On lit `$1`, `$2` ET l'adresse
# CONFIGURÉE du distant : git passe à `$2` l'adresse déjà réécrite par `url.<x>.insteadOf`
# (mesuré), qui peut ne plus nommer github.com.
DOSSIER_PRIVE="entreprise"
est_public=0
for adresse in "$1" "$2" \
  $(git config --get-all "remote.$1.url" 2>/dev/null) \
  $(git config --get-all "remote.$1.pushurl" 2>/dev/null); do
  printf '%s\n' "$adresse" | grep -qiE '(^|[@/.])github\.com([:/]|$)' && est_public=1
done

# QUELS COMMITS : ceux que ce push ENVOIE (absents des refs connues de ce distant). Un commit
# contient le dossier si son arbre a une entrée `entreprise` à la racine. Pour ne pas ouvrir chaque
# commit, on ne regarde que la pointe et les commits qui TOUCHENT le dossier : un commit qui le
# contient l'a forcément reçu d'un commit qui l'a ajouté (poussé aussi) ou d'un parent déjà publié.
# `--full-history` : sans lui, une fusion identique à un parent masquerait la branche d'à côté.
contient_prive() {
  [ -n "$(git ls-tree --name-only "$1" -- "$DOSSIER_PRIVE" 2>/dev/null)" ]
}

blocked=""
fuites=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  # Suppression de branche (local_sha tout à zéro) : hors périmètre de ce garde-fou.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if [ "$est_public" = "1" ]; then
    deja_publie=""
    case "$remote_sha" in
      *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && deja_publie="^$remote_sha" ;;
    esac
    for c in "$local_sha" $(git rev-list --full-history "$local_sha" $deja_publie --not --remotes="$1" -- "$DOSSIER_PRIVE" 2>/dev/null); do
      if contient_prive "$c"; then
        fuites="$fuites
    $remote_ref  ←  $(git log -1 --format='%h %s' "$c" 2>/dev/null)"
        break
      fi
    done
  fi
  target=$(printf '%s' "$remote_ref" | sed 's|^refs/heads/||')
  for p in $PROTECTED; do
    [ "$target" = "$p" ] && blocked="$blocked $target"
  done
done

if [ -n "$fuites" ]; then
  cat >&2 <<EOF

  ⛔ Push refusé vers le dépôt public ($1) : des commits envoyés contiennent $DOSSIER_PRIVE/,
  le dossier propre à l'entreprise, qui ne se publie jamais sur GitHub.
$fuites

  Ce dossier reste sur le disque, hors suivi git (.gitignore) : aucun commit ne doit le porter.
    - Travail parti de l'historique d'avant le 2026-10-16 : reprendre ses commits sur main un
      par un (git cherry-pick), jamais fusionner sa branche.
    - Commit qui l'a ajouté par erreur : le refaire sans lui
      (git rm -r --cached $DOSSIER_PRIVE, puis git commit --amend s'il est le dernier).

EOF
  exit 1
fi

# Dédoublonne (un même ref peut matcher via la liste + le HEAD distant).
blocked=$(printf '%s\n' $blocked | sort -u | tr '\n' ' ' | sed 's/ *$//')

if [ -n "$blocked" ] && [ "$is_agent" = "1" ] && [ "$ALLOW_MAIN_PUSH" != "1" ]; then
  current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  cat >&2 <<EOF

  ⛔ Push direct refusé sur : $blocked

  Ce push vient d'un contexte AGENT (Autowin OS). Règle d'équipe : 1 branche par sujet + Pull
  Request (ONBOARDING.md §7) — un agent ne publie pas sur la branche par défaut sans revue.

  Marche à suivre depuis la branche courante ($current) :

    git switch -c feat/<sujet>
    git push -u origin feat/<sujet>
    # puis ouvrir la Pull Request vers $blocked

  Exception assumée et tracée :  ALLOW_MAIN_PUSH=1 git push

EOF
  exit 1
fi
exit 0
