-- TESTS CACHES du banc arenagame : ne JAMAIS copier dans une copie de bras.
-- Execution : lune run regles.luau (depuis un dossier qui contient shared/Partie.luau)
-- Chaque cas imprime « CAS ok|ko <nom> [motif] », puis « SCORE <ok>/<total> ».

local Partie = require("./shared/Partie")

local resultats = { ok = 0, total = 0 }

local function cas(nom: string, f: () -> ())
	resultats.total += 1
	local ok, err = pcall(f)
	if ok then
		resultats.ok += 1
		print("CAS ok " .. nom)
	else
		print("CAS ko " .. nom .. " : " .. tostring(err):gsub("\n", " "))
	end
end

local function exiger(c: any, msg: string)
	if not c then
		error(msg, 0)
	end
end

local function proche(a: number, b: number, tol: number, msg: string)
	exiger(type(a) == "number" and math.abs(a - b) <= tol, string.format("%s (obtenu %s, attendu %s ±%s)", msg, tostring(a), tostring(b), tostring(tol)))
end

local PAS = 0.1
local function avancer(p, s: number)
	local n = math.floor(s / PAS + 0.5)
	for _ = 1, n do
		p:avancer(PAS)
	end
end

local function cout(id: string): number
	return Partie.CARTES[id].cout
end

local function estUnite(id: string): boolean
	return Partie.CARTES[id].type == "unite"
end

-- Joue la premiere carte UNITE jouable de la main ; fait tourner le cycle si besoin.
local function jouerUnite(p, j: number, x: number, y: number): (boolean, string?)
	local e = p:etat().joueurs[j]
	for i = 1, 4 do
		local id = e.main[i]
		if estUnite(id) and e.elixir >= cout(id) then
			local ok = p:jouer(j, i, x, y)
			return ok, id
		end
	end
	return false, nil
end

-- Envoie des unites sur une voie pendant `duree` secondes (adversaire passif).
local function pousser(p, j: number, x: number, y: number, duree: number, stop: (() -> boolean)?)
	local t = 0
	while t < duree do
		if p:etat().phase == "terminee" then
			return
		end
		jouerUnite(p, j, x, y)
		avancer(p, 0.5)
		t += 0.5
		if stop and stop() then
			return
		end
	end
end

-- Vide l'elixir en posant des cartes au fond de son camp.
local function vider(p, j: number)
	local y = j == 1 and 1 or 31
	for _ = 1, 20 do
		local e = p:etat().joueurs[j]
		local joue = false
		for i = 1, 4 do
			if e.elixir >= cout(e.main[i]) and p:jouer(j, i, 9, y) then
				joue = true
				break
			end
		end
		if not joue then
			return
		end
	end
end

local function tauxRecharge(p, j: number): number
	vider(p, j)
	local e0 = p:etat().joueurs[j].elixir
	avancer(p, 2.8)
	return p:etat().joueurs[j].elixir - e0
end

-- Index d'une carte UNITE en main (un sort peut se lancer partout : les tests de camp ne portent
-- que sur les unites). Fait tourner le cycle au fond de son camp si la main n'en a aucune.
local function indexUnite(p, j: number): number
	for _ = 1, 8 do
		local e = p:etat().joueurs[j]
		for i = 1, 4 do
			if estUnite(e.main[i]) then
				return i
			end
		end
		avancer(p, 10)
		p:jouer(j, 1, 9, j == 1 and 1 or 31)
	end
	error("aucune unite dans le deck", 0)
end

---------------------------------------------------------------- ELIXIR
cas("elixir initial a 5", function()
	proche(Partie.nouvelle(1):etat().joueurs[1].elixir, 5, 0.01, "elixir de depart")
end)

cas("recharge 1 elixir par 2,8 s en temps normal", function()
	local p = Partie.nouvelle(1)
	avancer(p, 20)
	proche(tauxRecharge(p, 1), 1, 0.25, "gain en 2,8 s a t=20")
end)

cas("elixir plafonne a 10", function()
	local p = Partie.nouvelle(1)
	avancer(p, 60)
	proche(p:etat().joueurs[1].elixir, 10, 0.01, "elixir apres 60 s sans jouer")
end)

cas("jouer une carte retire son cout", function()
	local p = Partie.nouvelle(2)
	avancer(p, 20)
	local e = p:etat().joueurs[1]
	local c = cout(e.main[1])
	exiger(p:jouer(1, 1, 9, 2), "coup legal refuse")
	proche(p:etat().joueurs[1].elixir, e.elixir - c, 0.05, "elixir apres le coup")
end)

cas("coup refuse sans assez d'elixir, etat intact", function()
	local p = Partie.nouvelle(3)
	vider(p, 1)
	local avant = p:etat().joueurs[1]
	local i
	for k = 1, 4 do
		if cout(avant.main[k]) > avant.elixir then
			i = k
			break
		end
	end
	exiger(i ~= nil, "aucune carte trop chere en main apres avoir vide l'elixir")
	exiger(not p:jouer(1, i, 9, 2), "coup trop cher accepte")
	local apres = p:etat().joueurs[1]
	proche(apres.elixir, avant.elixir, 0.001, "elixir modifie par un coup refuse")
	exiger(apres.main[i] == avant.main[i], "main modifiee par un coup refuse")
end)

cas("double elixir dans la derniere minute", function()
	local p = Partie.nouvelle(4)
	avancer(p, 130)
	proche(tauxRecharge(p, 1), 2, 0.3, "gain en 2,8 s a t=130")
end)

cas("pas de double elixir avant la derniere minute", function()
	local p = Partie.nouvelle(4)
	avancer(p, 100)
	proche(tauxRecharge(p, 1), 1, 0.25, "gain en 2,8 s a t=100")
end)

cas("double elixir en prolongation", function()
	local p = Partie.nouvelle(5)
	avancer(p, 185)
	exiger(p:etat().phase == "prolongation", "pas de prolongation a 0-0")
	exiger(tauxRecharge(p, 1) >= 1.7, "recharge trop lente en prolongation")
end)

---------------------------------------------------------------- CYCLE
cas("main de 4 cartes et deck de 8 distinctes", function()
	local e = Partie.nouvelle(6):etat().joueurs[1]
	exiger(#e.main == 4, "la main n'a pas 4 cartes")
	local vues = {}
	for _, id in e.main do
		exiger(Partie.CARTES[id] ~= nil, "carte inconnue du catalogue : " .. tostring(id))
		vues[id] = true
	end
	exiger(not vues[e.prochaine], "la prochaine carte est deja en main")
end)

cas("la carte jouee est remplacee par la prochaine", function()
	local p = Partie.nouvelle(7)
	avancer(p, 20)
	local e = p:etat().joueurs[1]
	local jouee, prochaine = e.main[2], e.prochaine
	exiger(p:jouer(1, 2, 9, 2), "coup legal refuse")
	local m = p:etat().joueurs[1].main
	local n = {}
	for _, id in m do
		n[id] = (n[id] or 0) + 1
	end
	exiger(n[prochaine] == 1, "la prochaine carte n'est pas entree en main")
	exiger(n[jouee] == nil, "la carte jouee est restee en main")
end)

cas("la carte jouee revient apres 4 autres coups", function()
	local p = Partie.nouvelle(8)
	avancer(p, 30)
	local x = p:etat().joueurs[1].main[1]
	exiger(p:jouer(1, 1, 9, 2), "premier coup refuse")
	for k = 1, 4 do
		avancer(p, 14) -- court : des unites jamais contrees finiraient par gagner la partie
		local e = p:etat().joueurs[1]
		if k == 4 then
			exiger(e.prochaine == x, "la carte jouee n'est pas prochaine apres 3 coups")
		end
		local joue = false
		for i = 1, 4 do
			if p:jouer(1, i, 9, 2) then
				joue = true
				break
			end
		end
		exiger(joue, "impossible de jouer le coup " .. k)
	end
	local m = p:etat().joueurs[1].main
	exiger(table.find(m, x) ~= nil, "la carte jouee n'est pas revenue apres 4 coups")
end)

---------------------------------------------------------------- POSE
cas("pose refusee dans le camp adverse", function()
	local p = Partie.nouvelle(9)
	avancer(p, 20)
	exiger(not p:jouer(1, indexUnite(p, 1), 9, 25), "J1 a pu poser une unite chez J2")
	exiger(not p:jouer(2, indexUnite(p, 2), 9, 5), "J2 a pu poser une unite chez J1")
end)

cas("pose refusee sur la riviere et hors arene", function()
	local p = Partie.nouvelle(9)
	avancer(p, 20)
	local i = indexUnite(p, 1)
	exiger(not p:jouer(1, i, 9, 16), "pose d'unite sur la riviere acceptee")
	exiger(not p:jouer(1, i, -1, 5), "pose hors arene acceptee")
	exiger(not p:jouer(1, i, 9, -2), "pose hors arene acceptee")
end)

cas("pose acceptee dans son propre camp pour les deux joueurs", function()
	local p = Partie.nouvelle(9)
	avancer(p, 20)
	exiger(p:jouer(1, indexUnite(p, 1), 9, 10), "J1 ne peut pas poser chez lui")
	exiger(p:jouer(2, indexUnite(p, 2), 9, 22), "J2 ne peut pas poser chez lui")
end)

cas("coups invalides refuses sans planter", function()
	local p = Partie.nouvelle(10)
	avancer(p, 20)
	exiger(not p:jouer(3, 1, 9, 5), "joueur 3 accepte")
	exiger(not p:jouer(1, 0, 9, 5), "index 0 accepte")
	exiger(not p:jouer(1, 5, 9, 5), "index 5 accepte")
	exiger(not p:jouer(1, 1, 0 / 0, 5), "x NaN accepte")
	p:avancer(0)
	local t = p:etat().temps
	p:avancer(-5)
	exiger(p:etat().temps >= t, "le temps a recule")
end)

---------------------------------------------------------------- COMBAT
cas("les unites avancent vers le camp adverse", function()
	local p = Partie.nouvelle(11)
	avancer(p, 20)
	local ok1 = jouerUnite(p, 1, 3.5, 12)
	local ok2 = jouerUnite(p, 2, 14.5, 20)
	exiger(ok1 and ok2, "aucune unite jouable")
	local y1, y2
	for _, u in p:etat().unites do
		if u.joueur == 1 then
			y1 = u.y
		else
			y2 = u.y
		end
	end
	avancer(p, 2)
	local n1, n2
	for _, u in p:etat().unites do
		if u.joueur == 1 then
			n1 = u.y
		else
			n2 = u.y
		end
	end
	exiger(y1 and n1 and n1 > y1, "l'unite de J1 n'avance pas vers le haut")
	exiger(y2 and n2 and n2 < y2, "l'unite de J2 n'avance pas vers le bas")
end)

cas("les tours tirent sur les unites", function()
	local p = Partie.nouvelle(12)
	avancer(p, 20)
	local ok, id = jouerUnite(p, 1, 3.5, 14)
	exiger(ok, "aucune unite jouable")
	local pvMax = Partie.CARTES[id].pv
	local blessee = false
	for _ = 1, 300 do
		p:avancer(0.1)
		local vue = false
		for _, u in p:etat().unites do
			if u.joueur == 1 then
				vue = true
				if u.pv < pvMax then
					blessee = true
				end
			end
		end
		if blessee or not vue then
			blessee = true
			break
		end
	end
	exiger(blessee, "l'unite n'a jamais ete touchee en 30 s")
end)

cas("des unites sans opposition abiment une tour", function()
	local p = Partie.nouvelle(13)
	local pv0 = p:etat().joueurs[2].tours.gauche.pv
	pousser(p, 1, 3.5, 12, 60)
	exiger(p:etat().joueurs[2].tours.gauche.pv < pv0, "la tour gauche de J2 est intacte apres 60 s")
end)

local function partieCouronne(graine: number)
	local p = Partie.nouvelle(graine)
	pousser(p, 1, 3.5, 12, 170, function()
		return p:etat().joueurs[2].tours.gauche.pv <= 0
	end)
	return p
end

cas("tour detruite : pv a 0 et une couronne", function()
	local p = partieCouronne(14)
	local e = p:etat()
	exiger(e.joueurs[2].tours.gauche.pv == 0, "la tour gauche de J2 n'est pas detruite en 170 s")
	exiger(e.joueurs[1].couronnes == 1, "couronnes de J1 : " .. tostring(e.joueurs[1].couronnes))
end)

cas("pose avancee du cote d'une princesse detruite", function()
	local p = Partie.nouvelle(15)
	avancer(p, 20)
	exiger(not p:jouer(1, indexUnite(p, 1), 3.5, 19), "pose chez J2 acceptee alors que sa tour est debout")
	p = partieCouronne(15)
	exiger(p:etat().joueurs[2].tours.gauche.pv == 0, "tour non detruite (prerequis)")
	exiger(p:etat().phase ~= "terminee", "partie deja terminee (prerequis)")
	avancer(p, math.min(15, 175 - p:etat().temps)) -- 15 s = 5,3 elixir ; rester avant 180 s : a 1-0 la partie s'arrete
	exiger(jouerUnite(p, 1, 3.5, 19), "pose refusee du cote de la princesse detruite")
	exiger(not jouerUnite(p, 1, 14.5, 19), "pose acceptee du cote de la princesse encore debout")
end)

---------------------------------------------------------------- FIN DE PARTIE
cas("prolongation a egalite au bout de 3 minutes", function()
	local p = Partie.nouvelle(16)
	avancer(p, 179)
	exiger(p:etat().phase == "normal", "phase avant 180 s : " .. tostring(p:etat().phase))
	avancer(p, 2)
	exiger(p:etat().phase == "prolongation", "phase a 181 s : " .. tostring(p:etat().phase))
end)

cas("victoire aux couronnes a la fin du temps", function()
	local p = partieCouronne(17)
	exiger(p:etat().joueurs[1].couronnes >= 1, "prerequis : J1 doit avoir une couronne")
	avancer(p, 185 - p:etat().temps)
	local e = p:etat()
	exiger(e.phase == "terminee", "partie non terminee a 185 s avec une couronne d'avance")
	exiger(e.vainqueur == 1, "vainqueur : " .. tostring(e.vainqueur))
end)

cas("mort subite en prolongation", function()
	local p = Partie.nouvelle(18)
	avancer(p, 181)
	pousser(p, 1, 3.5, 12, 115, function()
		return p:etat().joueurs[1].couronnes > 0
	end)
	local e = p:etat()
	exiger(e.joueurs[1].couronnes >= 1, "aucune couronne prise en prolongation")
	exiger(e.phase == "terminee" and e.vainqueur == 1, "la premiere couronne ne termine pas la prolongation")
end)

cas("la prolongation a une fin", function()
	local p = Partie.nouvelle(19)
	avancer(p, 400)
	local e = p:etat()
	exiger(e.phase == "terminee", "partie toujours en cours a 400 s")
	exiger(e.vainqueur == 0 or e.vainqueur == 1 or e.vainqueur == 2, "vainqueur invalide")
end)

cas("destruction du roi : trois couronnes et fin", function()
	local p = Partie.nouvelle(20)
	pousser(p, 1, 3.5, 12, 170, function()
		return p:etat().joueurs[2].tours.gauche.pv <= 0
	end)
	pousser(p, 1, 3.5, 19, 120, function()
		return p:etat().phase == "terminee"
	end)
	local e = p:etat()
	if e.joueurs[2].tours.roi.pv == 0 then
		exiger(e.joueurs[1].couronnes == 3, "roi detruit mais couronnes = " .. tostring(e.joueurs[1].couronnes))
	end
	exiger(e.phase == "terminee" and e.vainqueur == 1, "J1 ne gagne pas en attaquant seul")
end)

cas("partie terminee : plus rien ne bouge", function()
	local p = Partie.nouvelle(21)
	avancer(p, 400)
	local e = p:etat()
	exiger(e.phase == "terminee", "prerequis : partie terminee")
	exiger(not p:jouer(1, 1, 9, 5), "coup accepte apres la fin")
	avancer(p, 5)
	proche(p:etat().joueurs[1].elixir, e.joueurs[1].elixir, 0.001, "elixir modifie apres la fin")
end)

---------------------------------------------------------------- DETERMINISME ET COPIE
local function partieScriptee(graine: number)
	local p = Partie.nouvelle(graine)
	for k = 1, 60 do
		jouerUnite(p, 1, 3 + (k % 12), 8)
		jouerUnite(p, 2, 15 - (k % 12), 24)
		avancer(p, 1)
	end
	return p:etat()
end

local function empreinte(e): string
	local parts = { tostring(e.phase), string.format("%.3f", e.temps) }
	for j = 1, 2 do
		local J = e.joueurs[j]
		table.insert(parts, string.format("%.3f|%d|%s|%s", J.elixir, J.couronnes, table.concat(J.main, ","), J.prochaine))
		for _, nom in { "roi", "gauche", "droite" } do
			table.insert(parts, string.format("%.3f", J.tours[nom].pv))
		end
	end
	for _, u in e.unites do
		table.insert(parts, string.format("%d:%s:%.3f:%.3f:%.3f", u.joueur, u.carte, u.pv, u.x, u.y))
	end
	return table.concat(parts, ";")
end

cas("meme graine et memes coups : meme etat", function()
	exiger(empreinte(partieScriptee(22)) == empreinte(partieScriptee(22)), "deux parties identiques divergent")
end)

cas("etat() rend une copie", function()
	local p = Partie.nouvelle(23)
	local e = p:etat()
	e.joueurs[1].elixir = 99
	e.joueurs[2].tours.roi.pv = 0
	local f = p:etat()
	exiger(f.joueurs[1].elixir ~= 99, "modifier la copie change l'elixir de la partie")
	exiger(f.joueurs[2].tours.roi.pv > 0, "modifier la copie detruit une tour")
end)

print(string.format("SCORE %d/%d", resultats.ok, resultats.total))
