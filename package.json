{
  "name": "autowin-os",
  "version": "1.0.0",
  "description": "Autowin OS — cockpit d'orchestration d'agents",
  "main": "./out/main/index.js",
  "author": "Amitel",
  "autowin": {
    "learningOracles": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-brain-outcome-writeback.ps1",
        "covers": [
          "src/main/outcome-learning-policy.ts",
          "src/main/outcome-learning-proposal.ts",
          "src/main/outcome-learning-projector.ts",
          "src/main/outcome-learning-supervisor.ts",
          "src/main/outcome-learning-curation.ts",
          "src/main/activity/outcome-learning-ledger.ts",
          "src/main/activity/orchestration-outcome-trace.ts",
          "src/main/providers/causal-verification-evidence.ts",
          "src/main/providers/learning-oracle-manifest.ts",
          "src/main/brain-protocol.ts",
          "src/main/brain-remember.ts",
          "src/main/brain-inbox.ts",
          "src/main/amitel-context.ts",
          "src/main/phase-briefs.ts",
          "src/main/viz/fs-brains.ts",
          "src/shared/run-learning.ts",
          "src/shared/orchestration-outcome.ts",
          "src/renderer/src/components/BehaviourView.tsx",
          "src/renderer/src/components/GraphView.panels.tsx"
        ],
        "attests": [
          "scripts/verify-brain-outcome-writeback.ps1",
          "src/main/outcome-learning.integration.test.ts",
          "src/main/outcome-learning-policy.test.ts",
          "src/main/outcome-learning-proposal.test.ts",
          "src/main/outcome-learning-projector.test.ts",
          "src/main/outcome-learning-supervisor.test.ts",
          "src/main/outcome-learning-curation.test.ts",
          "src/main/activity/outcome-learning-ledger.test.ts",
          "src/main/activity/orchestration-outcome-trace.test.ts",
          "src/main/providers/causal-verification-evidence.test.ts",
          "src/main/providers/learning-oracle-manifest.test.ts",
          "src/main/phase-briefs.test.ts",
          "src/main/brain-protocol.test.ts",
          "src/main/brain-remember.test.ts",
          "src/main/brain-inbox.test.ts",
          "src/main/brain-inbox-race.test.ts",
          "src/main/amitel-context.test.ts",
          "src/shared/orchestration-outcome.test.ts",
          "src/renderer/src/components/BehaviourView.test.tsx",
          "src/renderer/src/components/GraphView.panels.test.tsx"
        ]
      },
      {
        "command": "npm run test:unit",
        "covers": [
          "src/**"
        ],
        "attests": [
          "vitest.config.ts",
          "package.json"
        ]
      },
      {
        "command": "npx vitest run",
        "covers": [
          "src/**"
        ],
        "attests": [
          "vitest.config.ts",
          "package.json"
        ]
      },
      {
        "command": "vitest run",
        "covers": [
          "src/**"
        ],
        "attests": [
          "vitest.config.ts",
          "package.json"
        ]
      },
      {
        "command": "vitest related",
        "couvreSesArguments": true,
        "covers": [],
        "attests": [
          "vitest.config.ts",
          "package.json"
        ]
      }
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "publier:main": "set ALLOW_MAIN_PUSH=1&& git push origin main",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "npm run typecheck && vitest run && npm run lint",
    "test:unit": "vitest run",
    "test:clean-generated": "powershell -ExecutionPolicy Bypass -File scripts/clean-generated-artifacts.test.ps1",
    "test:worktree-fingerprint": "powershell -ExecutionPolicy Bypass -File scripts/worktree-fingerprint.test.ps1",
    "test:launch-dev": "powershell -ExecutionPolicy Bypass -File scripts/launch-dev.test.ps1",
    "test:launch-dev-phases": "py -3 scripts/launch_dev_phases_test.py",
    "test:launch-dev-stdout": "py -3 scripts/launch_dev_stdout_test.py",
    "test:exit-recorder": "py -3 scripts/enregistreur_sortie_test.py",
    "codex:login": "tsx scripts/codex-login.mjs",
    "bootstrap:deps": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-deps.ps1",
    "clean:generated": "powershell -ExecutionPolicy Bypass -File scripts/clean-generated-artifacts.ps1",
    "context:compute-fabric": "node scripts/export-compute-fabric-context.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:desktop": "npm run build && electron-builder --dir && powershell -ExecutionPolicy Bypass -File scripts/refresh-desktop-shortcut.ps1",
    "dev:shortcut": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/create-dev-shortcut.ps1",
    "build:unpack": "npm run build:desktop",
    "build:win": "npm run build:desktop && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "scout:residus": "node scripts/scout-residus.mjs src",
    "scout:rendement": "node scripts/scout-rendement.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@napi-rs/keyring": "1.3.0",
    "fflate": "^0.8.3",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^11.16.1",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring-win32-x64-msvc": "1.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^20.11.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  }
}
